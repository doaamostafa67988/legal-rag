# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches
.ruff_cache/
.pytest_cache/

# Source PDFs (large / copyrighted) - keep out of git
data/raw/*.pdf
*:Zone.Identifier

.env
.env-*

# Vector store is rebuilt by legal_rag.rag ingest
chroma_db/


# Exported model artifacts (large; tracked with DVC in Module 2)
models/*
!models/*.dvc

.coverage
htmlcov/
data/cache/
# Terraform: state holds every value in clear text (including passwords); providers are re-downloaded
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!terraform.tfvars.example
crash.log
infra/tfplan
